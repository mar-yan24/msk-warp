# Session docs. The research record stays on disk only (decision 2026-09-07,
# reaffirmed 2026-09-10) -- with one exception: docs/VALIDITY.md, the running
# validity ledger, is long-lived and needs real history, blame and review.
# Note 'docs/*' rather than 'docs/': git cannot re-include a file whose parent
# directory is excluded by a directory pattern.
docs/*
!docs/VALIDITY.md

# Claude
.claude/

# Local-only archive of abandoned experiments (preserved as
# archive/shac-testing-2026-05-07 tag)
archive/

# Stray PowerShell artifact (Windows)
Microsoft/

# Regenerated diagnostic plots (derived from tests/data/*.pkl
# via scripts/plot_policy_gradient_diagnostic.py)
tests/data/plots/

# Bake-off venvs
.venv-*/

# Kept on disk only, never committed (decision 2026-09-07): research record,
# bake-off harness, env scripts, assistant instructions
bench/
scripts/env/
CLAUDE.md

# MuJoCo writes this when the engine emits a warning (e.g. the deliberate
# instability regression in tests/unit/test_stability.py)
MUJOCO_LOG.TXT
